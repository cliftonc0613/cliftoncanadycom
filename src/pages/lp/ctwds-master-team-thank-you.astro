---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="You're In | CT Web Design Shop"
  description="Thanks for signing up. Check your inbox for the CT Web Design Shop team roster."
  noindex={true}
>
  <main class="ty-main">
    <div class="ty-card">
      <div class="ty-check">
        <svg width="40" height="40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="ty-headline">You're In</h1>
      <p class="ty-subhead">
        Check your inbox, the CT Web Design Shop team roster is on its way.
      </p>
      <a href="/" class="ty-link">Back to cliftoncanady.com</a>
    </div>
  </main>
</Layout>

<style>
  .ty-main {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    background: hsl(var(--primary));
  }

  .ty-card {
    width: 100%;
    max-width: 440px;
    text-align: center;
    background: hsl(var(--background));
    border-radius: 1rem;
    padding: 3rem 2rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
  }

  .ty-check {
    width: 72px;
    height: 72px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: hsl(var(--accent) / 0.12);
    color: hsl(var(--accent));
  }

  .ty-headline {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    color: hsl(var(--foreground));
    margin-bottom: 0.75rem;
  }

  .ty-subhead {
    font-family: 'Roboto Mono', monospace;
    font-size: 1rem;
    line-height: 1.6;
    color: hsl(var(--foreground) / 0.75);
    margin-bottom: 2rem;
  }

  .ty-link {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    color: hsl(var(--accent));
    text-decoration: none;
  }

  .ty-link:hover {
    text-decoration: underline;
  }
</style>
