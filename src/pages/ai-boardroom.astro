---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Join AI Boardroom | Clifton T. Canady"
  description="Join the AI Boardroom Upstate SC list. Get session announcements, founding-member rates, and AI strategy insights built for Upstate SC business leaders."
>
  <main>
    <section class="opt-in-section">
      <!-- Content -->
      <div class="opt-in-content">
        <span class="opt-in-eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          AI BOARDROOM &nbsp;&bull;&nbsp; UPSTATE SC
          <span class="eyebrow-dot" aria-hidden="true"></span>
        </span>

        <h1 class="opt-in-headline">
          Strategic Advisory for Upstate SC Business Leaders
        </h1>

        <p class="opt-in-subhead">
          Get session announcements, founding-member rates, and AI strategy insights before anyone else.
        </p>

        <!-- Scarcity line -->
        <p class="opt-in-scarcity">
          <span class="scarcity-dot" aria-hidden="true"></span>
          Limited to 12 Upstate SC leaders per session
        </p>

        <!-- Form Card -->
        <div class="opt-in-card">
          <form
            id="opt-in-form"
            class="opt-in-form"
            aria-describedby="form-message"
          >
            <!-- Honeypot -->
            <input type="text" name="honeypot" class="is-hidden" tabindex="-1" autocomplete="off">

            <div class="field-group">
              <label for="firstName" class="opt-in-label">First Name</label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                autocomplete="given-name"
                class="opt-in-input"
                placeholder="Your first name"
              >
            </div>

            <div class="field-group">
              <label for="email" class="opt-in-label">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="opt-in-input"
                placeholder="your@email.com"
              >
            </div>

            <button type="submit" id="submit-btn" class="opt-in-btn">
              <span id="submit-text" class="btn-content">
                Reserve My Spot
                <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span id="loading-text" class="btn-content is-hidden">
                <svg class="btn-spinner" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <circle cx="8" cy="8" r="6" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
                  <path d="M8 2a6 6 0 0 1 6 6" stroke="white" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Submitting...
              </span>
            </button>
          </form>

          <div
            id="form-message"
            class="form-message is-hidden"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          ></div>
        </div>

        <p class="opt-in-reassurance">No spam. Unsubscribe anytime.</p>
      </div>
    </section>
  </main>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('opt-in-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const submitText = document.getElementById('submit-text');
    const loadingText = document.getElementById('loading-text');
    const messageDiv = document.getElementById('form-message');

    if (!form) return;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const honeypot = form.querySelector('input[name="honeypot"]') as HTMLInputElement | null;
      if (honeypot && honeypot.value) return;

      const formData = new FormData(form);
      const firstName = (formData.get('firstName') as string).trim();
      const email = (formData.get('email') as string).trim();

      if (!firstName || !email) {
        showMessage('Please fill in all required fields.', 'error');
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showMessage('Please enter a valid email address.', 'error');
        return;
      }

      setLoadingState(true);
      hideMessage();

      try {
        const response = await fetch(
          'https://services.leadconnectorhq.com/hooks/O3A0THtKcMOzi34vEwru/webhook-trigger/ed527b14-84fc-4ccd-9411-05288ff4873f',
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ firstName, email }),
          }
        );

        if (response.ok) {
          showMessage("You're on the list! Redirecting...", 'success');
          setTimeout(() => {
            window.location.href = '/ai-boardroom-ty-5signs';
          }, 1500);
        } else {
          throw new Error('Submission failed');
        }
      } catch {
        showMessage('Something went wrong. Please try again or call (864) 752-8017.', 'error');
        setLoadingState(false);
      }
    });

    function setLoadingState(loading: boolean) {
      if (!submitBtn || !submitText || !loadingText) return;
      submitBtn.disabled = loading;
      submitText.classList.toggle('is-hidden', loading);
      loadingText.classList.toggle('is-hidden', !loading);
      submitBtn.classList.toggle('is-loading', loading);
    }

    function showMessage(message: string, type: 'success' | 'error') {
      if (!messageDiv) return;
      messageDiv.textContent = message;
      messageDiv.className = `form-message form-message--${type}`;
    }

    function hideMessage() {
      if (!messageDiv) return;
      messageDiv.className = 'form-message is-hidden';
    }
  });
</script>

<style>
  /* ── Utility ── */
  .is-hidden {
    display: none !important;
  }

  /* ── Section ── */
  .opt-in-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-image: url('/images/ai-boardroom.jpg');
    background-size: cover;
    background-position: center;
  }

  .opt-in-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, hsl(var(--primary) / 0.88) 0%, hsl(var(--primary) / 0.78) 100%);
    z-index: 0;
  }

  /* ── Content wrapper ── */
  .opt-in-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
    padding: 5rem 1.25rem 3rem;
    text-align: center;
    color: white;
  }

  /* ── Eyebrow ── */
  .opt-in-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Roboto Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: hsl(var(--accent));
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: hsl(var(--accent));
    flex-shrink: 0;
  }

  /* ── Headline ── */
  .opt-in-headline {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-bottom: 1rem;
  }

  /* ── Subhead ── */
  .opt-in-subhead {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 1.25rem;
  }

  /* ── Scarcity ── */
  .opt-in-scarcity {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: 'Poppins', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1.75rem;
  }

  .scarcity-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: hsl(var(--accent));
    flex-shrink: 0;
  }

  /* ── Card ── */
  .opt-in-card {
    background: #ffffff;
    border-radius: 12px;
    box-shadow:
      0 25px 50px -12px rgba(15, 23, 42, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.06);
    padding: 2.25rem;
    margin-bottom: 1rem;
    text-align: left;
  }

  /* ── Form ── */
  .opt-in-form {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  /* ── Labels ── */
  .opt-in-label {
    font-family: 'Poppins', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    color: hsl(var(--primary));
    letter-spacing: 0.01em;
  }

  /* ── Inputs ── */
  .opt-in-input {
    width: 100%;
    padding: 0.875rem 1rem;
    border-radius: 6px;
    background: #f9fafb;
    border: 1.5px solid #e5e7eb;
    color: hsl(var(--primary));
    font-family: 'Roboto Mono', monospace;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .opt-in-input::placeholder {
    color: #9ca3af;
  }

  .opt-in-input:hover {
    border-color: #cbd5e1;
    background: #ffffff;
  }

  .opt-in-input:focus-visible {
    border-color: hsl(var(--accent));
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(246, 103, 51, 0.2);
  }

  /* ── Submit button ── */
  .opt-in-btn {
    width: 100%;
    margin-top: 0.375rem;
    padding: 0.9375rem 1.5rem;
    background-color: hsl(var(--accent));
    color: white;
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 180ms ease,
      opacity 180ms ease;
  }

  .btn-content {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .opt-in-btn:hover:not(:disabled) {
    background-color: #e55a2d;
    transform: scale(1.02);
    box-shadow: 0 8px 20px -4px rgba(246, 103, 51, 0.45);
  }

  .opt-in-btn:active:not(:disabled) {
    transform: translateY(1px) scale(1.01);
    box-shadow: 0 4px 10px -4px rgba(246, 103, 51, 0.35);
  }

  .opt-in-btn:focus-visible {
    outline: 3px solid white;
    outline-offset: 2px;
    box-shadow: 0 0 0 5px hsl(var(--accent) / 0.4);
  }

  .opt-in-btn:disabled,
  .opt-in-btn.is-loading {
    cursor: not-allowed;
    opacity: 0.7;
    transform: none;
    box-shadow: none;
  }

  .btn-arrow {
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
    flex-shrink: 0;
  }

  .opt-in-btn:hover:not(:disabled) .btn-arrow {
    transform: translateX(3px);
  }

  /* Spinner animation */
  .btn-spinner {
    animation: spin 700ms linear infinite;
    flex-shrink: 0;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ── Form message ── */
  .form-message {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    text-align: center;
  }

  .form-message--success {
    background: #ecfdf5;
    color: #0e8b5c;
    border: 1px solid #a7f3d0;
  }

  .form-message--error {
    background: #fef2f2;
    color: #b42a2a;
    border: 1px solid #fecaca;
  }

  /* ── Reassurance ── */
  .opt-in-reassurance {
    font-family: 'Poppins', sans-serif;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.78);
    text-align: center;
  }

  /* ── Entrance animation ── */
  @media (prefers-reduced-motion: no-preference) {
    .opt-in-eyebrow,
    .opt-in-headline,
    .opt-in-subhead,
    .opt-in-scarcity,
    .opt-in-card,
    .opt-in-reassurance {
      opacity: 0;
      transform: translateY(10px);
      animation: fade-up 400ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .opt-in-eyebrow      { animation-delay:   0ms; }
    .opt-in-headline     { animation-delay:  80ms; }
    .opt-in-subhead      { animation-delay: 160ms; }
    .opt-in-scarcity     { animation-delay: 220ms; }
    .opt-in-card         { animation-delay: 300ms; }
    .opt-in-reassurance  { animation-delay: 380ms; }
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Mobile ── */
  @media (max-width: 480px) {
    .opt-in-card {
      padding: 1.75rem 1.25rem;
    }
  }
</style>
